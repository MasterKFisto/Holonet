# Holonet environment configuration.
# Copy to .env and fill in the placeholders.
# NEVER commit real secrets, AccessKeys, passwords, or private keys
# (docs/PROJECT_RULES.md rule 10).

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://holonet.section-zero.link
DATABASE_URL=postgres://holonet:holonet@localhost:5432/holonet

# Local dashboard origin(s) allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

ALIBABA_CLOUD_REGION=<ALIBABA_CLOUD_REGION>
ALIBABA_CLOUD_ACCOUNT_ID=<ALIBABA_CLOUD_ACCOUNT_ID>
OSS_PUBLIC_BUCKET=holonet-section-zero-public
OSS_PRIVATE_BUCKET=holonet-section-zero-private
OSS_ENDPOINT=https://oss-<ALIBABA_CLOUD_REGION>.aliyuncs.com
OSS_PUBLIC_BASE_URL=https://holonet-section-zero-public.oss-<ALIBABA_CLOUD_REGION>.aliyuncs.com

# Path to the uploaded dashboard asset manifest (GET / HTML shell).
# Defaults to infra/alibaba/dashboard-assets.json in the repository.
DASHBOARD_ASSET_MANIFEST_PATH=

# Storage provider: 'fs' (local filesystem, development) or 'oss' (production).
STORAGE_PROVIDER=fs
STORAGE_LOCAL_DIR=.holonet-storage

# OSS region for the storage package (falls back to ALIBABA_CLOUD_REGION).
OSS_REGION=<ALIBABA_CLOUD_REGION>

# OSS AccessKey pair for local OSS testing only. On Function Compute,
# credentials come from the RAM role via STS (PLACEHOLDER — deployment phase).
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Optional RAM role ARN for STS credentials on Function Compute.
OSS_ROLE_ARN=

# Session signing secret — must be at least 32 characters (HS256).
# Development placeholder; replace for any non-local use.
AUTH_SECRET=holonet-dev-secret-change-me-0000000000
SESSION_COOKIE_NAME=holonet_session
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=true

# Initial admin password for the local database seed (placeholder — replace
# for any non-local use; stored as a scrypt hash, never plaintext).
ADMIN_INITIAL_PASSWORD=change-me-admin

AI_PROVIDER=manual
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=

FC_FUNCTION_NAME_APP=holonet-app
FC_FUNCTION_NAME_BUILDER=holonet-builder
FC_ROLE_ARN=acs:ram::<ALIBABA_CLOUD_ACCOUNT_ID>:role/holonet-fc-role

VPC_ID=<VPC_ID>
VSWITCH_IDS=<VSWITCH_IDS>
SECURITY_GROUP_ID=<SECURITY_GROUP_ID>
