{
  "name": "holonet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holonet — security-first static website platform (pnpm monorepo).",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "db:generate": "pnpm --filter @holonet/db db:generate",
    "db:migrate": "pnpm --filter @holonet/db db:migrate",
    "db:seed": "pnpm --filter @holonet/db db:seed",
    "db:studio": "pnpm --filter @holonet/db db:studio",
    "dashboard:upload": "node infra/scripts/upload-dashboard-assets.mjs",
    "deploy:check": "bash infra/scripts/deploy-check.sh",
    "deploy:package": "bash infra/scripts/package-api.sh && bash infra/scripts/package-builder.sh",
    "deploy:fc": "bash infra/scripts/deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "ali-oss": "^6.20.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vitest": "^2.1.3"
  }
}
