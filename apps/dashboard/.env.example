# Holonet dashboard environment (Vite).
# Copy to .env.local for local overrides — never commit real secrets.

# Public API base URL. Defaults to http://localhost:3000 in development.
# In production the dashboard is served behind https://holonet.section-zero.link
# and relative /api requests hit the same origin.
VITE_PUBLIC_API_BASE_URL=http://localhost:3000
