{
  "name": "@holonet/builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holonet static site build worker (Function Compute function).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@holonet/core": "workspace:*",
    "@holonet/db": "workspace:*",
    "@holonet/security": "workspace:*",
    "@holonet/static-generator": "workspace:*",
    "@holonet/storage": "workspace:*",
    "@holonet/templates": "workspace:*",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
