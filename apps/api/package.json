{
  "name": "@holonet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holonet HTTP API (Hono) with a Function Compute entrypoint.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alicloud/fc20230330": "^4.8.3",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/openapi-core": "^1.0.8",
    "@darabonba/typescript": "^1.0.5",
    "@holonet/ai": "workspace:*",
    "@holonet/builder": "workspace:*",
    "@holonet/core": "workspace:*",
    "@holonet/db": "workspace:*",
    "@holonet/security": "workspace:*",
    "@holonet/storage": "workspace:*",
    "@holonet/templates": "workspace:*",
    "@hono/node-server": "^1.13.5",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
