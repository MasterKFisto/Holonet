# Holonet Function Compute deployment environment.
#
# Copy to infra/alibaba/.env.deploy (git-ignored) and fill in real values.
# NEVER commit real AccessKeys, DB passwords, or AUTH_SECRET
# (docs/PROJECT_RULES.md rules 10/11).
#
# Credentials for Serverless Devs itself live in its access profile, not here:
#   s config add --AccessKeyID <RAM user AK> --AccessKeySecret <RAM user SK> -a holonet

# Alibaba Cloud region (e.g. cn-hangzhou) and account id.
ALIBABA_CLOUD_REGION=<ALIBABA_CLOUD_REGION>
ALIBABA_CLOUD_ACCOUNT_ID=<ALIBABA_CLOUD_ACCOUNT_ID>

# OSS buckets (create before the first deployment).
OSS_PUBLIC_BUCKET=holonet-section-zero-public
OSS_PRIVATE_BUCKET=holonet-section-zero-private

# Function Compute execution role (least privilege — see infra/alibaba/ram/).
FC_ROLE_ARN=acs:ram::<ALIBABA_CLOUD_ACCOUNT_ID>:role/holonet-fc-role

# VPC attachment (PostgreSQL in Docker lives inside this VPC).
VPC_ID=<VPC_ID>
VSWITCH_IDS=<VSWITCH_IDS>
SECURITY_GROUP_ID=<SECURITY_GROUP_ID>

# Platform hostname (configurable — see docs/deployment.md,
# "Changing the platform hostname"). PUBLIC_BASE_URL is the full https:// URL;
# PUBLIC_DOMAIN is the bare domain bound to holonet-app in s.yaml's
# customDomains block (DNS record + HTTPS certificate required).
PUBLIC_BASE_URL=https://holonet.section-zero.link
PUBLIC_DOMAIN=holonet.section-zero.link

# Private PostgreSQL (Docker host inside the VPC — never a public endpoint).
DATABASE_URL=postgres://holonet:<DB_PASSWORD>@<DB_PRIVATE_HOST>:5432/holonet

# Session signing secret — replace with a strong random value (≥32 chars).
AUTH_SECRET=<AUTH_SECRET>

# Optional overrides (defaults in s.yaml / .env.example):
# OSS_REGION=<ALIBABA_CLOUD_REGION>
# OSS_ENDPOINT=https://oss-<ALIBABA_CLOUD_REGION>.aliyuncs.com
# OSS_PUBLIC_BASE_URL=https://holonet-section-zero-public.oss-<ALIBABA_CLOUD_REGION>.aliyuncs.com
# OSS_ROLE_ARN=<FC_ROLE_ARN>
# FC_BUILDER_MEMORY=1024
# CORS_ORIGINS=https://holonet.section-zero.link
# AI_PROVIDER=manual
# AI_ENDPOINT=
# AI_API_KEY=
# AI_MODEL=holonet-heuristics
# SLS_PROJECT=holonet-sls
# SLS_LOGSTORE=holonet-app